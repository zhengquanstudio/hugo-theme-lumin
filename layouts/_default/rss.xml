{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description | default "Recent content" }}</description>
    <language>{{ site.Language.Lang }}</language>
    {{ with site.Params.author }}<author>{{ . }}</author>{{ end }}
    <lastBuildDate>{{ time.Now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{ with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{- if .Params.password -}}
      {{ printf "<![CDATA[🔒 这是一篇加密文章，请访问原文输入密码查看完整内容。]]>" | safeHTML }}
      {{- else -}}
      {{- $desc := .Summary | html | replaceRE "\\x1b\\[[0-9;]*[a-zA-Z]" "" | replaceRE "\\]\\]>" "]]&gt;" -}}
      {{- printf "<![CDATA[%s]]>" $desc | safeHTML -}}
      {{- end -}}
    </item>
    {{ end }}
  </channel>
</rss>
